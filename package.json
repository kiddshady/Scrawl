{
  "name": "scrawl",
  "version": "0.1.0",
  "description": "Scrawl — draw and mark up, straight from the tablet.",
  "main": "main.js",
  "author": "Kidd_Shady",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "electron . --selftest",
    "shot": "electron . --ui-shot=.shots/ui.png:demo",
    "shot:puck": "electron . --ui-shot=.shots/puck.png:puck",
    "icons": "electron build/make-icon.js && magick build/icon.png -define icon:auto-resize=256,128,64,48,32,16 build/icon.ico",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.umbrovex.scrawl",
    "productName": "Scrawl",
    "copyright": "Copyright © 2026 Umbrovex Systems",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!renderer/js/dev/**",
      "!renderer/selftest.html"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "scrawl",
        "name": "Scrawl drawing",
        "description": "Scrawl drawing",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ]
  }
}
